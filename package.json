{
  "name": "prisma-errors-handler",
  "version": "1.0.0",
  "description": "A lightweight Prisma error handler for Node.js applications",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "node build.js"
  },
  "keywords": [
    "prisma",
    "prisma-error",
    "error-handler",
    "nodejs",
    "javascript",
    "backend"
  ],
