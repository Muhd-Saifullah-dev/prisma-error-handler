  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "type": "commonjs",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "vitest": "^5.0.1"
  }
}